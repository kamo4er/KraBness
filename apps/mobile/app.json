{
  "expo": {
    "name": "KraBness",
    "slug": "kamharn",
    "version": "0.1.42",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111318",
    "android": {
      "package": "dev.kamharn.app",
      "versionCode": 43,
      "adaptiveIcon": {
        "backgroundColor": "#111318",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "googleServicesFile": "./credentials/google-services.json"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна, чтобы сканировать QR-код хаба и снимать фото для агента.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к фото — чтобы отправлять их агенту."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ],
      "./plugins/with-local-toolchain.js",
      "./plugins/with-release-signing.js",
      "expo-speech-recognition",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#3b82f6"
        }
      ]
    ]
  }
}
