{
  "name": "@kamharn/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.10",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-image-picker": "~58.0.10",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.5",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "^58.0.0",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild -p android --no-install",
    "apk": "npm run prebuild && cd android && .\\gradlew.bat assembleRelease",
    "apk:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "apk:publish": "node scripts/publish-apk.mjs",
    "release": "npm run apk && npm run apk:publish"
  },
  "private": true
}
